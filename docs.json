{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Nelphia",
  "colors": {
    "primary": "#ecfcca",
    "light": "#a3b3ff",
    "dark": "#a3b3ff"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "openapi": "openapi.json",
    "examples": {
      "autogenerate": true
    }
  },
  "background": {
    "color": {
      "light": "#0a0a0a",
      "dark": "#0a0a0a"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Geist"
  },
  "markdown": {
    "schema": true
  },
  "icons": {
    "library": "lucide"
  },
  "thumbnails": {
    "appearance": "dark"
  }
}
